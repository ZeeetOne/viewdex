# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Database (Supabase PostgreSQL, used by Prisma) ---
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# Pooled connection (Transaction pooler, port 6543) for the app runtime
DATABASE_URL=
# Direct connection (port 5432) for Prisma migrations / db push
DIRECT_URL=

# --- Supabase Auth ---
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Rate limiting (Upstash Redis, optional in dev) ---
# https://console.upstash.com -> Redis -> REST API
# Leave empty to disable rate limiting (local development)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
